# AI Health Companion - Environment Configuration

# AI Provider: "bedrock" for AWS (production), "anthropic" for direct API (dev)
AI_PROVIDER=bedrock

# Anthropic Direct API (when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# AWS Bedrock (when AI_PROVIDER=bedrock) — Claude Sonnet 4
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=apac.anthropic.claude-sonnet-4-20250514-v1:0

# Storage: "aws" for DynamoDB (production), "local" for JSON files (dev)
STORAGE_MODE=aws

# DynamoDB Tables
DYNAMODB_TABLE_PROFILES=HealthCompanion_Profiles
DYNAMODB_TABLE_TIMELINE=HealthCompanion_Timeline
DYNAMODB_TABLE_CONVERSATIONS=HealthCompanion_Conversations

# S3
S3_BUCKET=health-companion-images

# Server
HOST=0.0.0.0
PORT=8000

# Local storage (dev only)
LOCAL_DATA_DIR=./data
